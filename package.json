{
  "name": "open-charts",
  "version": "0.2.0",
  "description": "Open-source, consulting-quality charts for PowerPoint",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "open-charts": "./src/cli.ts"
  },
  "scripts": {
    "examples": "node --experimental-strip-types --no-warnings src/cli.ts examples/deck.json -o out/deck",
    "live": "node --experimental-strip-types --no-warnings tools/live/main.ts",
    "e2e:powerpoint": "node --experimental-strip-types --no-warnings tools/live/main.ts --install all",
    "e2e:agenda": "node --experimental-strip-types --no-warnings tools/live/main.ts agenda",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\" && npm run test:perf",
    "test:perf": "node --experimental-strip-types --no-warnings --test test/perf/perf.test.ts",
    "e2e": "playwright test -c test/e2e",
    "goldens": "node --experimental-strip-types --no-warnings test/goldens/run.ts",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench.ts",
    "bench:accept": "node --experimental-strip-types --no-warnings test/bench/accept.ts",
    "quality": "node --experimental-strip-types --no-warnings scripts/quality.ts",
    "build:mac": "node --experimental-strip-types --no-warnings scripts/build-mac.ts",
    "check:mac-pkg": "node --experimental-strip-types --no-warnings scripts/check-mac-pkg.ts",
    "build:msi": "node --experimental-strip-types --no-warnings scripts/build-msi.ts",
    "build:win": "node --experimental-strip-types --no-warnings scripts/build-win.ts",
    "build:officejs": "node --experimental-strip-types --no-warnings scripts/build-officejs.ts",
    "officejs:cert": "node --experimental-strip-types --no-warnings scripts/officejs-cert.ts",
    "officejs:serve": "node --experimental-strip-types --no-warnings src/officejs/server.ts",
    "officejs:sideload": "node --experimental-strip-types --no-warnings scripts/officejs-sideload.ts",
    "officejs:live": "node --experimental-strip-types --no-warnings tools/officejs-live.ts",
    "build:popup": "node --experimental-strip-types --no-warnings scripts/build-popup.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}
