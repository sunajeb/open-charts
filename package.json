{
  "name": "open-charts",
  "version": "0.2.0",
  "description": "Open-source, consulting-quality charts for PowerPoint",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "open-charts": "./src/cli.ts"
  },
  "scripts": {
    "examples": "node --experimental-strip-types --no-warnings src/cli.ts examples/deck.json -o out/deck",
    "e2e:powerpoint": "node --experimental-strip-types --no-warnings tools/e2e-powerpoint.ts",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\" && npm run test:perf",
    "test:perf": "node --experimental-strip-types --no-warnings --test test/perf/perf.test.ts",
    "e2e": "playwright test -c test/e2e",
    "goldens": "node --experimental-strip-types --no-warnings test/goldens/run.ts",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench.ts",
    "bench:accept": "node --experimental-strip-types --no-warnings test/bench/accept.ts",
    "build:win": "node --experimental-strip-types --no-warnings scripts/build-win.ts",
    "quality": "node --experimental-strip-types --no-warnings scripts/quality.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.25.10",
    "postject": "1.0.0-alpha.6"
  }
}
