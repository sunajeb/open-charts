{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-charts.dev/schema/chart/1.json",
  "title": "open-charts chart spec, version 1",
  "description": "One chart. Unversioned specs (v0) have the same shape and are upgraded by migrate(). Semantic rules the schema cannot express (values per series = number of categories, unique series names, cagr.from < cagr.to, horizontal only for column types, tuple length per scatter / bubble, gantt end after start) are enforced by validateSpec().",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "categories", "series"],
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "const": 1 },
    "type": { "enum": ["stacked", "clustered", "percent", "waterfall", "mekko", "line", "area", "area100", "pie", "doughnut", "harvey", "combo", "mekkoxy", "scatter", "bubble", "table", "gantt"] },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Category labels. Years (\"2024\", \"FY24\", \"2025E\"), quarters (\"Q1 2023\"), halves (\"H1 2023\"), months (\"Jan 2023\", \"2023-01\") and ISO dates are read as dates for CAGR."
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/series" }
    },
    "options": { "$ref": "#/$defs/options" }
  },
  "$defs": {
    "hexColor": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
    "categoryIndex": { "type": "integer", "minimum": 0 },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/categoryIndex" },
        "to": { "$ref": "#/$defs/categoryIndex" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string" },
        "values": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "number" },
              { "type": "null" },
              { "const": "e", "description": "Waterfall only: this category is a computed total." },
              { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" }, "description": "Scatter: [x, y]; bubble: [x, y, size]. The category is the point's label." },
              { "type": "string", "description": "Gantt: a date (\"2026-03-15\", \"Mar 2026\", \"Q2 2026\"). Table: text shown as is." }
            ]
          }
        },
        "color": { "$ref": "#/$defs/hexColor" },
        "as": { "enum": ["column", "line"], "description": "Combination chart: draw this series as a line over the columns." }
      }
    },
    "unit": {
      "anyOf": [
        { "type": "string", "description": "Suffix without a space, e.g. \"m\" or \"%\"." },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "position": { "enum": ["prefix", "suffix"], "default": "suffix" },
            "space": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totals": { "type": "boolean" },
        "cagr": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "$ref": "#/$defs/categoryIndex" },
                "to": { "$ref": "#/$defs/categoryIndex" },
                "years": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "difference": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/range" }] },
        "valueAxis": { "type": "boolean" },
        "zeroBased": { "type": "boolean" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 10 },
        "unit": { "$ref": "#/$defs/unit" },
        "format": { "type": "string", "pattern": "[0#?]", "description": "Excel number format, e.g. \"#,##0.0\", \"$#,##0\", \"0%\", \"#,##0;(#,##0)\"." },
        "locale": { "type": "string", "examples": ["en-US", "en-GB", "en-IN", "de-DE", "fr-FR"] },
        "scale": { "enum": ["none", "auto", "k", "m", "bn"] },
        "orientation": { "enum": ["vertical", "horizontal"] },
        "mekko": { "enum": ["percent", "unit"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 10 },
        "seriesLabels": { "enum": ["right", "legend", "none"] },
        "totalsAt": { "type": "array", "items": { "$ref": "#/$defs/categoryIndex" } },
        "step": { "type": "boolean", "description": "Line only: step (ortho) line, horizontal then vertical." },
        "percentData": { "type": "boolean", "description": "100% chart: values are already percentages; columns keep their own totals on the % axis." },
        "combo": { "enum": ["stacked", "clustered"], "description": "Combination chart: how the column series are drawn." },
        "sort": { "enum": ["sheet", "reverse", "ascending", "descending"], "description": "Mekko XY: category order (by height for ascending / descending)." },
        "axisTitles": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scatter and bubble: axis titles.",
          "properties": { "x": { "type": "string" }, "y": { "type": "string" } }
        },
        "shades": {
          "type": "array",
          "description": "Gantt: shaded periods across every row.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "brackets": {
          "type": "array",
          "description": "Gantt: brackets labelling periods of time (phases), under the rows.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "today": { "type": "string", "description": "Gantt: date of a \"today\" line through every row." },
        "sizeLegend": { "type": ["boolean", "string"], "description": "Bubble: size legend; a string adds a caption." },
        "labelContent": { "enum": ["percent", "value", "both"], "description": "Pie and doughnut: slice labels show shares (default), absolute values, or both." }
      }
    }
  }
}
