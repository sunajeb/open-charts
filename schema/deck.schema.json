{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-charts.dev/schema/deck/1.json",
  "title": "open-charts deck spec, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["slides"],
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "const": 1 },
    "style": { "$ref": "https://open-charts.dev/schema/chart/1.json#/$defs/style" },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "A slide with one chart (\"chart\") or several (\"charts\").",
        "oneOf": [{ "required": ["chart"] }, { "required": ["charts"] }],
        "properties": {
          "title": { "type": "string" },
          "chart": { "$ref": "https://open-charts.dev/schema/chart/1.json" },
          "charts": {
            "type": "array",
            "minItems": 1,
            "description": "Several charts on one slide. Without frames they share the chart area side by side.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chart"],
              "properties": {
                "frame": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "w", "h"],
                  "description": "Where the chart goes, in points from the slide's top-left corner (the slide is 960 x 540).",
                  "properties": {
                    "x": { "type": "number" }, "y": { "type": "number" },
                    "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 }
                  }
                },
                "chart": { "$ref": "https://open-charts.dev/schema/chart/1.json" }
              }
            }
          }
        }
      }
    }
  }
}
